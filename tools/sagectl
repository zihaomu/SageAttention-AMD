def load_campaign(campaign_id: str) -> dict[str, Any]:
    if not re.fullmatch(r"[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?", campaign_id):
        raise SagectlError(f"invalid campaign ID: {campaign_id}")
    path = ROOT / "benchmarks" / "campaigns" / f"{campaign_id}.json"
    try:
        campaign = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SagectlError(f"campaign not found: {path.relative_to(ROOT)}") from exc
    except json.JSONDecodeError as exc:
        raise SagectlError(f"invalid campaign JSON: {exc}") from exc
    if not isinstance(campaign, dict) or campaign.get("campaign_id") != campaign_id:
        raise SagectlError("campaign identity mismatch")
    return campaign


def invoke_benchmark(
    *,
    gpu: int,
    platform_id: str,
    kernel_id: str,
    workload_id: str,
    iterations: int,
    rocm_path: str,
    max_gpu_use: int,
    max_memory_use: int,
) -> dict[str, Any]:
    command = [
        sys.executable,
        str(ROOT / "tools" / "sagectl"),
        "benchmark",
        "--gpu",
        str(gpu),
        "--platform",
        platform_id,
        "--kernel",
        kernel_id,
        "--workload",
        workload_id,
        "--iterations",
        str(iterations),
        "--rocm-path",
        rocm_path,
        "--max-gpu-use",
        str(max_gpu_use),
        "--max-memory-use",
        str(max_memory_use),
    ]
    completed = run(command, cwd=ROOT)
    if completed.returncode:
        raise SagectlError(
            f"benchmark trial failed for {kernel_id}/{workload_id}:\n"
            f"{completed.stdout}"
        )
    try:
        result = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise SagectlError(
            f"benchmark trial returned invalid summary JSON:\n{completed.stdout}"
        ) from exc
    if not isinstance(result, dict):
        raise SagectlError("benchmark trial summary must be an object")
    return result


def trial_passes_gates(summary: dict[str, Any], gates: dict[str, Any]) -> bool:
    correctness = summary.get("correctness", {})
    if correctness.get("non_finite") != 0:
        return False
    if gates.get("require_determinism") and correctness.get("deterministic") is not True:
        return False
    if gates.get("require_guard_canaries") and correctness.get("guard_canaries") is not True:
        return False
    if gates.get("require_cpu_reference") and correctness.get("cpu_reference") != "pass":
        return False
    return True


def geometric_mean(values: Sequence[float]) -> float:
    if not values or any(value <= 0.0 for value in values):
        raise SagectlError("geometric mean requires positive values")
    return math.exp(sum(math.log(value) for value in values) / len(values))


def run_static_campaign_gates(campaign: dict[str, Any]) -> list[dict[str, str]]:
    platform_record = load_registry_record("platforms", campaign["platform_id"])
    architecture = platform_record["gpu"]["architecture"]
    build_directory = architecture_build_directory(architecture)
    make_prefix = [
        "make",
        f"HIP_ARCHS={architecture}",
        f"BUILD_DIR={build_directory}",
    ]
    commands = [
        ["make", "metadata-check"],
        [*make_prefix, "contract-test"],
    ]
    selectors = {
        load_registry_record("kernels", kernel_id).get("selector")
        for kernel_id in [
            campaign["baseline_kernel_id"],
            *campaign["candidate_kernel_ids"],
        ]
    }
    if "e27_gfx12_d128" in selectors:
        commands.append([*make_prefix, "isa"])
    records: list[dict[str, str]] = []
    for command in commands:
        completed = run(command, cwd=ROOT)
        if completed.returncode:
            raise SagectlError(
                f"static campaign gate failed: {' '.join(command)}\n"
                f"{completed.stdout}"
            )
        records.append({"command": " ".join(command), "status": "pass"})
    return records


def search_command(args: argparse.Namespace) -> int:
    campaign = load_campaign(args.campaign)
    static_gates = run_static_campaign_gates(campaign)
    platform_id = campaign["platform_id"]
    baseline_id = campaign["baseline_kernel_id"]
    candidate_ids = campaign["candidate_kernel_ids"]
    workload_ids = campaign["workload_ids"]
    gates = campaign["gates"]
    metric = campaign["objective"]["metric"]
    short_iterations = gates["short_iterations"]
    confirmation_iterations = gates["confirmation_iterations"]
    confirmation_runs = gates["confirmation_runs"]
    top_k = gates["top_k_for_confirmation"]
    trials: list[dict[str, Any]] = []

    short_baselines: dict[str, float] = {}
    for workload_id in workload_ids:
        baseline = invoke_benchmark(
            gpu=args.gpu,
            platform_id=platform_id,
            kernel_id=baseline_id,
            workload_id=workload_id,
            iterations=short_iterations,
            rocm_path=args.rocm_path,
            max_gpu_use=args.max_gpu_use,
            max_memory_use=args.max_memory_use,
        )
        if not trial_passes_gates(baseline, gates):
            raise SagectlError(f"baseline failed campaign gates: {workload_id}")
        short_baselines[workload_id] = baseline["metrics_ms"][metric]
        trials.append(
            {
                "stage": "short",
                "role": "baseline",
                "workload_id": workload_id,
                "summary": baseline,
            }
        )

    rankings: list[dict[str, Any]] = []
    for kernel_id in candidate_ids:
        speedups: list[float] = []
        passed = True
        for workload_id in workload_ids:
            candidate = invoke_benchmark(
                gpu=args.gpu,
                platform_id=platform_id,
                kernel_id=kernel_id,
                workload_id=workload_id,
                iterations=short_iterations,
                rocm_path=args.rocm_path,
                max_gpu_use=args.max_gpu_use,
                max_memory_use=args.max_memory_use,
            )
            gate_pass = trial_passes_gates(candidate, gates)
            passed = passed and gate_pass
            candidate_metric = candidate["metrics_ms"][metric]
            speedup = short_baselines[workload_id] / candidate_metric
            speedups.append(speedup)
            trials.append(
                {
                    "stage": "short",
                    "role": "candidate",
                    "kernel_id": kernel_id,
                    "workload_id": workload_id,
                    "gate_pass": gate_pass,
                    "paired_speedup": speedup,
                    "summary": candidate,
                }
            )
        rankings.append(
            {
                "kernel_id": kernel_id,
                "gate_pass": passed,
                "short_geomean_speedup": geometric_mean(speedups),
            }
        )
    eligible = sorted(
        (entry for entry in rankings if entry["gate_pass"]),
        key=lambda entry: entry["short_geomean_speedup"],
        reverse=True,
    )
    if not eligible:
        raise SagectlError("no candidate survived the short-run gates")
    finalists = [entry["kernel_id"] for entry in eligible[:top_k]]

    confirmed_speedups: dict[str, list[float]] = {
        kernel_id: [] for kernel_id in finalists
    }
    for confirmation_run in range(confirmation_runs):
        for workload_id in workload_ids:
            baseline = invoke_benchmark(
                gpu=args.gpu,
                platform_id=platform_id,
                kernel_id=baseline_id,
                workload_id=workload_id,
                iterations=confirmation_iterations,
                rocm_path=args.rocm_path,
                max_gpu_use=args.max_gpu_use,
                max_memory_use=args.max_memory_use,
            )
            if not trial_passes_gates(baseline, gates):
                raise SagectlError("confirmation baseline failed campaign gates")
            baseline_metric = baseline["metrics_ms"][metric]
            trials.append(
                {
                    "stage": "confirmation",
                    "round": confirmation_run + 1,
                    "role": "baseline",
                    "workload_id": workload_id,
                    "summary": baseline,
                }
            )
            for kernel_id in finalists:
                candidate = invoke_benchmark(
                    gpu=args.gpu,
                    platform_id=platform_id,
                    kernel_id=kernel_id,
                    workload_id=workload_id,
                    iterations=confirmation_iterations,
                    rocm_path=args.rocm_path,
                    max_gpu_use=args.max_gpu_use,
                    max_memory_use=args.max_memory_use,
                )
                if not trial_passes_gates(candidate, gates):
                    raise SagectlError(
                        f"confirmation candidate failed gates: {kernel_id}"
                    )
                speedup = baseline_metric / candidate["metrics_ms"][metric]
                confirmed_speedups[kernel_id].append(speedup)
                trials.append(
                    {
                        "stage": "confirmation",
                        "round": confirmation_run + 1,
                        "role": "candidate",
                        "kernel_id": kernel_id,
                        "workload_id": workload_id,
                        "paired_speedup": speedup,
                        "summary": candidate,
                    }
                )

    confirmations = [
        {
            "kernel_id": kernel_id,
            "paired_speedup_median": statistics.median(speedups),
            "paired_speedup_geomean": geometric_mean(speedups),
            "paired_samples": len(speedups),
        }
        for kernel_id, speedups in confirmed_speedups.items()
    ]
    confirmations.sort(
        key=lambda entry: entry["paired_speedup_median"], reverse=True
    )
    best = confirmations[0]
    accepted = (
        best["paired_speedup_median"]
        >= float(campaign["acceptance"]["minimum_speedup"])
    )
    revision, source_dirty = git_source_state()
    recorded_at = dt.datetime.now().astimezone()
    timestamp = recorded_at.astimezone(dt.timezone.utc).strftime(
        "%Y%m%d-%H%M%S-%f-z"
    )
    report = {
        "schema_version": 1,
        "campaign_id": args.campaign,
        "recorded_at": recorded_at.isoformat(timespec="seconds"),
        "git_commit": revision,
        "source_dirty": source_dirty,
        "evidence_level": "research",
        "physical_device_index": args.gpu,
        "objective": campaign["objective"],
        "static_gates": static_gates,
        "short_rankings": rankings,
        "confirmations": confirmations,
        "recommendation": {
            "kernel_id": best["kernel_id"] if accepted else None,
            "accepted_by_campaign_threshold": accepted,
            "promotion_eligible": False,
            "note": "Local campaign recommendation only; review clean-commit evidence before promotion.",
        },
        "trials": trials,
    }
    report_path = (
        ROOT
        / "build"
        / "sagectl"
        / "campaigns"
        / f"{args.campaign}-{timestamp}.json"
    )
    write_canonical_json(report_path, report, force=False)
    print(
        json.dumps(
            {
                "campaign_id": args.campaign,
                "source_dirty": source_dirty,
                "short_rankings": rankings,
                "confirmations": confirmations,
                "recommendation": report["recommendation"],
                "report": str(report_path.relative_to(ROOT)),
            },
            indent=2,
        )
    )
    return 0


