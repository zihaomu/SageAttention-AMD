def doctor(args: argparse.Namespace) -> int:
    rocm_path = Path(args.rocm_path)
    hipcc = command_path("hipcc", rocm_path)
    rocm_smi = command_path("rocm-smi", rocm_path)
    smi = run([rocm_smi, "--showproductname", "--showuse", "--showmemuse", "--csv"])
    if smi.returncode:
        raise SagectlError(f"rocm-smi probe failed:\n{smi.stdout}")
    devices = parse_rocm_smi(smi.stdout)
    selected = next((device for device in devices if device["index"] == args.gpu), None)
    if selected is None:
        available = ", ".join(str(device["index"]) for device in devices)
        raise SagectlError(f"physical GPU {args.gpu} not found; available: {available}")

    hipcc_version = run([hipcc, "--version"])
    if hipcc_version.returncode:
        raise SagectlError(f"hipcc --version failed:\n{hipcc_version.stdout}")
    hip, compiler = parse_hipcc_version(hipcc_version.stdout)
    rocm = rocm_version(rocm_path, hipcc_version.stdout)
    probe = hip_runtime_probe(hipcc, args.gpu, selected["architecture"])
    if selected["architecture"] and not probe["architecture"].startswith(
        selected["architecture"]
    ):
        raise SagectlError(
            "rocm-smi and HIP disagree on selected GPU architecture: "
            f"{selected['architecture']} versus {probe['architecture']}"
        )
    operating_system, os_slug = os_information()
    record = make_platform_record(
        probe=probe,
        device_count=len(devices),
        rocm=rocm,
        hip=hip,
        compiler=compiler,
        operating_system=operating_system,
        os_slug=os_slug,
        requested_platform_id=args.platform_id,
    )
    output = (
        Path(args.output)
        if args.output
        else ROOT / "build" / "sagectl" / "platforms" / f"{record['platform_id']}.json"
    )
    write_canonical_json(output, record, args.force)

    gpu_use = selected["gpu_use_percent"]
    memory_use = selected["memory_use_percent"]
    benchmark_ready = (
        gpu_use is not None
        and memory_use is not None
        and gpu_use <= args.max_gpu_use
        and memory_use <= args.max_memory_use
    )
    summary = {
        "selected_physical_gpu": args.gpu,
        "gpu_use_percent": gpu_use,
        "memory_use_percent": memory_use,
        "benchmark_ready": benchmark_ready,
        "runtime_probe": probe["runtime_probe"],
        "platform_id": record["platform_id"],
        "draft": str(output.resolve().relative_to(ROOT)),
    }
    print(json.dumps(summary, indent=2))
    if args.require_idle and not benchmark_ready:
        raise SagectlError(
            "selected GPU does not satisfy the requested idle thresholds"
        )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sagectl")
    subparsers = parser.add_subparsers(dest="command", required=True)
    doctor_parser = subparsers.add_parser(
        "doctor", help="probe one explicit AMD GPU and generate a platform draft"
    )
    doctor_parser.add_argument("--gpu", type=int, required=True, help="physical GPU index")
    doctor_parser.add_argument(
        "--rocm-path", default=str(DEFAULT_ROCM_PATH), help="ROCm installation prefix"
    )
    doctor_parser.add_argument("--platform-id", help="reviewed stable platform ID")
    doctor_parser.add_argument(
        "--output", help="draft path inside the repository (default: build/sagectl/platforms/)"
    )
    doctor_parser.add_argument("--force", action="store_true", help="replace an existing draft")
    doctor_parser.add_argument("--require-idle", action="store_true")
    doctor_parser.add_argument("--max-gpu-use", type=int, default=5)
    doctor_parser.add_argument("--max-memory-use", type=int, default=1)
    doctor_parser.set_defaults(function=doctor)

    plan_parser = subparsers.add_parser(
        "plan", help="generate a canonical interval plan from a workload record"
    )
    plan_parser.add_argument("--workload", required=True)
    plan_parser.add_argument("--output", help="plan path inside the repository")
    plan_parser.set_defaults(function=plan_command)

    benchmark_parser = subparsers.add_parser(
        "benchmark", help="run a registry-driven generic interval benchmark"
    )
    benchmark_parser.add_argument("--gpu", type=int, required=True)
    benchmark_parser.add_argument("--platform", required=True)
    benchmark_parser.add_argument("--kernel", required=True)
    benchmark_parser.add_argument("--workload", required=True)
    benchmark_parser.add_argument("--iterations", type=int, default=5)
    benchmark_parser.add_argument(
        "--rocm-path", default=str(DEFAULT_ROCM_PATH), help="ROCm installation prefix"
    )
    benchmark_parser.add_argument("--max-gpu-use", type=int, default=5)
    benchmark_parser.add_argument("--max-memory-use", type=int, default=1)
    benchmark_parser.set_defaults(function=benchmark_command)

    baseline_parser = subparsers.add_parser(
        "baseline", help="qualify and benchmark the registered portable exact baseline"
    )
    baseline_parser.add_argument("--gpu", type=int, required=True)
    platform_group = baseline_parser.add_mutually_exclusive_group(required=True)
    platform_group.add_argument("--platform")
    platform_group.add_argument(
        "--platform-draft", help="doctor-generated platform JSON inside the repository"
    )
    baseline_parser.add_argument("--workload", required=True)
    baseline_parser.add_argument("--iterations", type=int, default=5)
    baseline_parser.add_argument(
        "--rocm-path", default=str(DEFAULT_ROCM_PATH), help="ROCm installation prefix"
    )
    baseline_parser.add_argument("--max-gpu-use", type=int, default=5)
    baseline_parser.add_argument("--max-memory-use", type=int, default=1)
    baseline_parser.set_defaults(function=baseline_command)

    search_parser = subparsers.add_parser(
        "search", help="execute a validated optimization campaign"
    )
    search_parser.add_argument("--gpu", type=int, required=True)
    search_parser.add_argument("--campaign", required=True)
    search_parser.add_argument(
        "--rocm-path", default=str(DEFAULT_ROCM_PATH), help="ROCm installation prefix"
    )
    search_parser.add_argument("--max-gpu-use", type=int, default=5)
    search_parser.add_argument("--max-memory-use", type=int, default=1)
    search_parser.set_defaults(function=search_command)

    report_parser = subparsers.add_parser(
        "report", help="show the latest local report for a campaign"
    )
    report_parser.add_argument("--campaign", required=True)
    report_parser.set_defaults(function=report_command)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.function(args))
    except SagectlError as exc:
        print(f"sagectl: error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
